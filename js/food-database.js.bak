/* ═══════════════════════════════════════════════════════════════
   FoodDB Module — CRUD + Rendering
═══════════════════════════════════════════════════════════════ */

const FoodDB = (() => {
  let currentEditId   = null;
  let firebaseFoods   = [];
  let searchTerm      = "";

  /* ── Initialise ───────────────────────────────────────────── */

  async function init() {
    await loadFirebaseFoods();
    renderLocalFoods();
    renderFirebaseFoods();
    updateCounts();
  }

  /* ── Load Custom Foods from Firebase/localStorage ─────────── */

  async function loadFirebaseFoods() {
    try {
      firebaseFoods = await dbGetAll("foods");
    } catch {
      firebaseFoods = [];
    }
  }

  /* ── Get All Foods (local + firebase) ─────────────────────── */

  function getAllFoods() {
    return [...LOCAL_FOODS, ...firebaseFoods];
  }

  function getFoodById(id) {
    return getAllFoods().find(f => f.id === id) || null;
  }

  /* ── Render Local Foods Grid ──────────────────────────────── */

  function renderLocalFoods(filter = "") {
    const grid = document.getElementById("local-foods-grid");
    if (!grid) return;
    const foods = LOCAL_FOODS.filter(f =>
      f.name.toLowerCase().includes(filter) ||
      (f.nameUrdu || "").includes(filter)
    );
    grid.innerHTML = foods.map(f => buildFoodCard(f, false)).join("") || emptyState("No matching foods");
  }

  /* ── Render Firebase Foods Grid ───────────────────────────── */

  function renderFirebaseFoods(filter = "") {
    const grid = document.getElementById("firebase-foods-grid");
    if (!grid) return;
    const foods = firebaseFoods.filter(f =>
      f.name.toLowerCase().includes(filter) ||
      (f.nameUrdu || "").includes(filter)
    );
    if (!foods.length) {
      grid.innerHTML = `<div class="empty-state"><i class="fas fa-cloud-upload-alt"></i><p>No custom foods added yet</p></div>`;
      return;
    }
    grid.innerHTML = foods.map(f => buildFoodCard(f, true)).join("");
  }

  /* ── Build Food Card HTML ─────────────────────────────────── */

  function buildFoodCard(food, editable) {
    const costClass = food.cost === "medium" ? "medium" : "";
    const costLabel = food.cost === "low" ? "Low Cost" : food.cost === "medium" ? "Mid Cost" : "High";
    return `
      <div class="fdb-card" id="fdb-${food.id}">
        ${food.isLocal ? '<div class="fdb-local-tag">PRE-LOADED</div>' : ""}
        <div class="fdb-top">
          <span class="fdb-emoji">${food.emoji || "🍽️"}</span>
          <div>
            <div class="fdb-name">${escHtml(food.name)}</div>
            ${food.nameUrdu ? `<div class="fdb-urdu">${food.nameUrdu}</div>` : ""}
          </div>
        </div>
        <div class="fdb-macros">
          <span class="fdb-macro kcal">⚡ ${food.per100g.calories} kcal</span>
          <span class="fdb-macro">🥩 ${food.per100g.protein}g</span>
          <span class="fdb-macro">🧈 ${food.per100g.fat}g fat</span>
          <span class="fdb-macro ${costClass}">${costLabel}</span>
        </div>
        ${food.tips ? `<p style="font-size:.75rem;color:var(--text-2);line-height:1.4;">${escHtml(food.tips)}</p>` : ""}
        <div class="fdb-actions">
          ${editable ? `
            <button class="btn btn-sm btn-outline" onclick="FoodDB.editFood('${food.id}')"><i class="fas fa-edit"></i> Edit</button>
            <button class="btn btn-sm btn-danger"  onclick="FoodDB.deleteFood('${food.id}')"><i class="fas fa-trash"></i></button>
          ` : `
            <button class="btn btn-sm btn-outline" style="width:100%" onclick="DietPlanner.openAddModal('${food.id}')">
              <i class="fas fa-plus"></i> Add to Diet
            </button>
          `}
        </div>
      </div>`;
  }

  /* ── Search ───────────────────────────────────────────────── */

  function search(term) {
    searchTerm = term.toLowerCase().trim();
    renderLocalFoods(searchTerm);
    renderFirebaseFoods(searchTerm);
  }

  /* ── Modal: Add/Edit ──────────────────────────────────────── */

  function openModal(foodId = null) {
    currentEditId = foodId;
    const modal = document.getElementById("modal-food");
    const title = document.getElementById("modal-food-title");
    clearForm();
    if (foodId) {
      title.textContent = "Edit Food Item";
      const food = getFoodById(foodId);
      if (food) populateForm(food);
    } else {
      title.textContent = "Add Food Item";
    }
    modal.style.display = "flex";
  }

  function closeModal() {
    document.getElementById("modal-food").style.display = "none";
    clearForm();
    currentEditId = null;
  }

  function overlayClose(e) {
    if (e.target === document.getElementById("modal-food")) closeModal();
  }

  function clearForm() {
    document.getElementById("food-edit-id").value    = "";
    document.getElementById("food-name").value        = "";
    document.getElementById("food-name-urdu").value   = "";
    document.getElementById("food-category").value    = "grain";
    document.getElementById("food-cost").value        = "low";
    document.getElementById("food-emoji").value       = "";
    document.getElementById("food-cal").value         = "";
    document.getElementById("food-prot").value        = "";
    document.getElementById("food-carb").value        = "";
    document.getElementById("food-fat").value         = "";
    document.getElementById("food-tips").value        = "";
  }

  function populateForm(food) {
    document.getElementById("food-edit-id").value    = food.id;
    document.getElementById("food-name").value        = food.name;
    document.getElementById("food-name-urdu").value   = food.nameUrdu || "";
    document.getElementById("food-category").value    = food.category || "grain";
    document.getElementById("food-cost").value        = food.cost || "low";
    document.getElementById("food-emoji").value       = food.emoji || "";
    document.getElementById("food-cal").value         = food.per100g.calories;
    document.getElementById("food-prot").value        = food.per100g.protein;
    document.getElementById("food-carb").value        = food.per100g.carbs;
    document.getElementById("food-fat").value         = food.per100g.fat;
    document.getElementById("food-tips").value        = food.tips || "";
  }

  /* ── Save Food ─────────────────────────────────────────────── */

  async function saveFood() {
    const name = document.getElementById("food-name").value.trim();
    if (!name) { AppController.showToast("Food name is required", "error"); return; }

    const cal  = parseFloat(document.getElementById("food-cal").value);
    const prot = parseFloat(document.getElementById("food-prot").value);
    const carb = parseFloat(document.getElementById("food-carb").value);
    const fat  = parseFloat(document.getElementById("food-fat").value);

    if (isNaN(cal) || isNaN(prot) || isNaN(carb) || isNaN(fat)) {
      AppController.showToast("All nutrition values must be numbers", "error");
      return;
    }

    const food = {
      name,
      nameUrdu:  document.getElementById("food-name-urdu").value.trim(),
      category:  document.getElementById("food-category").value,
      cost:      document.getElementById("food-cost").value,
      emoji:     document.getElementById("food-emoji").value.trim() || "🍽️",
      per100g:   { calories: cal, protein: prot, carbs: carb, fat },
      tips:      document.getElementById("food-tips").value.trim(),
      isLocal:   false
    };

    try {
      const editId = document.getElementById("food-edit-id").value;
      if (editId) {
        await dbUpdate("foods", editId, food);
        const idx = firebaseFoods.findIndex(f => f.id === editId);
        if (idx !== -1) firebaseFoods[idx] = { ...firebaseFoods[idx], ...food };
        AppController.showToast("Food item updated", "success");
      } else {
        const newId = await dbSave("foods", food);
        firebaseFoods.unshift({ id: newId, ...food, createdAt: new Date().toISOString() });
        AppController.showToast("Food item added", "success");
      }
      renderFirebaseFoods(searchTerm);
      DietPlanner.refreshFoodLibrary();
      updateCounts();
      closeModal();
    } catch (err) {
      AppController.showToast("Error saving food: " + err.message, "error");
    }
  }

  /* ── Edit Food ─────────────────────────────────────────────── */

  function editFood(id) {
    const food = firebaseFoods.find(f => f.id === id);
    if (!food) return;
    openModal(id);
  }

  /* ── Delete Food ───────────────────────────────────────────── */

  async function deleteFood(id) {
    if (!confirm("Delete this food item? This cannot be undone.")) return;
    try {
      await dbDelete("foods", id);
      firebaseFoods = firebaseFoods.filter(f => f.id !== id);
      renderFirebaseFoods(searchTerm);
      DietPlanner.refreshFoodLibrary();
      updateCounts();
      AppController.showToast("Food item deleted", "info");
    } catch (err) {
      AppController.showToast("Error deleting: " + err.message, "error");
    }
  }

  /* ── Update Counts ─────────────────────────────────────────── */

  function updateCounts() {
    const lc = document.getElementById("local-food-count");
    const fc = document.getElementById("firebase-food-count");
    if (lc) lc.textContent = LOCAL_FOODS.length + " items";
    if (fc) fc.textContent = firebaseFoods.length + " items";
  }

  /* ── Helpers ───────────────────────────────────────────────── */

  function emptyState(msg) {
    return `<div class="empty-state"><i class="fas fa-search"></i><p>${msg}</p></div>`;
  }

  /* ── Public API ────────────────────────────────────────────── */
  return {
    init, getAllFoods, getFoodById, search,
    openModal, closeModal, overlayClose, saveFood, editFood, deleteFood
  };

})();
